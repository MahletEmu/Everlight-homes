# Everlight Homes Ethiopia — Environment Variables Example
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit your actual .env.local with credentials to version control.

# MongoDB Connection
# Replace with your MongoDB Atlas or local MongoDB connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/everlight_homes?retryWrites=true&w=majority
# Alternative for local development:
# MONGODB_URI=mongodb://localhost:27017/everlight_homes

# Authentication & Session Security
# Generate a strong 32+ character random secret (e.g. `openssl rand -base64 32`)
JWT_SECRET=your-secure-random-32-byte-secret-key-change-in-production
AUTH_COOKIE_NAME=everlight_session

# Commission Policy Settings (in Ethiopian Birr - ETB)
# Commission rate as percentage of first month's rent (e.g. 50 = 50%)
COMMISSION_PERCENTAGE=50
COMMISSION_PAYER=landlord
COMMISSION_DUE_DAYS=7

# Cloudinary Storage (Optional for real cloud image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Credentials (used by server provisioning script: npm run seed)
INITIAL_ADMIN_EMAIL=admin@everlight.et
INITIAL_ADMIN_PASSWORD=EverlightAdmin2026!
INITIAL_ADMIN_NAME=Everlight Head Moderator

# App Configuration
NEXT_PUBLIC_APP_NAME="Everlight Homes Ethiopia"
NEXT_PUBLIC_DEFAULT_CURRENCY=ETB
NEXT_PUBLIC_APP_URL=http://localhost:3000
